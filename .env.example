# Copy this file to .env.local (and to .env for the Prisma CLI) and fill in real values.
# .env / .env*.local are gitignored — never commit real keys.

# Database (Prisma + Postgres). Provision one on Vercel (Storage tab),
# Supabase, or Neon, then paste its connection string here. `npm run build`
# runs `prisma migrate deploy` automatically, so a fresh database gets its
# schema created on the first deploy — no manual migration step needed.
# For local dev, the simplest option is to point at the same production
# database via `vercel env pull .env.local` after provisioning it.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin login (single shared password, no user accounts). Set ONE of these:
# - ADMIN_PASSWORD: plain text, compared server-side. Fine for local/dev.
# - ADMIN_PASSWORD_HASH: a bcrypt hash, for production. Generate with:
#     node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie (JWT). Use any long random string; a
# different value invalidates existing sessions.
SESSION_SECRET=

# Optional: Vercel Blob storage for uploaded blog images. Without it, uploads
# are written to public/uploads on local disk — fine for local dev, but this
# does NOT persist reliably on Vercel's serverless filesystem in production.
BLOB_READ_WRITE_TOKEN=

# The site's own URL, used for canonical links on blog article pages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
