// SmartEye Blog CMS — Prisma schema.
//
// Uses Postgres. Locally, point DATABASE_URL at any reachable Postgres
// instance (the same production database works fine for local dev too —
// `vercel env pull .env.local` after provisioning one on Vercel). The
// `npm run build` script runs `prisma migrate deploy` automatically, so a
// fresh database gets its schema created on the first deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String
  content       String // sanitized HTML from the Tiptap editor
  featuredImage String?
  author        String
  category      String
  tags          String // comma-separated — SQLite has no native array type
  status        BlogStatus @default(DRAFT)

  // Presentation only — controls which layout renders the article on the
  // public site (src/components/blog-templates). Existing rows and any row
  // that omits this get the default, so nothing needs a data backfill.
  templateSlug String @default("modern-article")

  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // SEO
  seoTitle        String?
  metaDescription String?
  focusKeywords   String?
  canonicalUrl    String?
  ogImage         String?
  socialTitle     String?
  socialDescription String?

  comments Comment[]

  @@index([status])
  @@index([slug])
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

model Comment {
  id       String        @id @default(cuid())
  blogId   String
  blog     Blog          @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parentId String? // set for a reply; null for a top-level comment
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("CommentReplies")
  name     String
  email    String
  website  String?
  content  String
  status   CommentStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([blogId])
  @@index([parentId])
}

model ChatLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  page      String? // path the visitor was on when they submitted
  createdAt DateTime @default(now())

  @@index([email])
}
